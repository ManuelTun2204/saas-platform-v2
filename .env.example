# IA (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-tu_clave_aqui

# Email (Resend)
RESEND_API_KEY=re_tu_clave_aqui
ADMIN_EMAIL=tu@email.com

# Seguridad JWT (obligatorio en produccion: usa un valor largo y aleatorio)
JWT_SECRET_KEY=cambia_esto_por_un_secreto_largo_y_aleatorio

# CORS (origins permitidos separados por coma. * = todos)
ALLOWED_ORIGINS=*

# URL pública de la app (se usa en emails y código de embed del widget)
PUBLIC_URL=http://localhost:8000

# Postgres (Fase 3 - migracion de JSON a base de datos)
DB_USER=saas
DB_PASSWORD=cambia_esto
DB_NAME=saas
DATABASE_URL=postgresql://saas:cambia_esto@db:5432/saas
