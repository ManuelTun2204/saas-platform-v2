# IA (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-tu_clave_aqui

# Email (Resend)
RESEND_API_KEY=re_tu_clave_aqui
ADMIN_EMAIL=tu@email.com

# Seguridad JWT (obligatorio en produccion: usa un valor largo y aleatorio)
JWT_SECRET_KEY=cambia_esto_por_un_secreto_largo_y_aleatorio

# CORS (origins permitidos separados por coma. * = todos)
ALLOWED_ORIGINS=*

# URL pública de la app (se usa en emails y código de embed del widget)
PUBLIC_URL=http://localhost:8000

# Pagos (opcional). Si dejas todo vacio se activa el modo DEMO (pago simulado).
# Pasarelas disponibles: stripe, mercadopago, paypal. Formato: "stripe,mercadopago,paypal" o "all"
PAYMENT_PROVIDERS=all

# Stripe (test keys empiezan con sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Mercado Pago (token sandbox empieza con TEST-)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# PayPal (sandbox: client id/secret de developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Precios de los paquetes (USD)
PRICE_FULL=399
PRICE_WEB_CHAT=249
PRICE_CHAT_ONLY=99

# Postgres (Fase 3 - migracion de JSON a base de datos)
DB_USER=saas
DB_PASSWORD=cambia_esto
DB_NAME=saas
DATABASE_URL=postgresql://saas:cambia_esto@db:5432/saas
